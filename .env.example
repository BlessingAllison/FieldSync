# ─────────────────────────────────────────────────────────────────────────────
# FieldSync environment. Copy with `make bootstrap` (generates every __GENERATE__
# value with a CSPRNG and writes .env with mode 600). Never commit .env.
# ─────────────────────────────────────────────────────────────────────────────

# ── Stack ───────────────────────────────────────────────────────────────────
# Settings module for the API container: dev | demo | prod  (config.settings.<env>)
FIELDSYNC_ENV=demo
# Host ports (127.0.0.1 only). Chosen not to collide with other local stacks.
FIELDSYNC_WEB_PORT=8090
FIELDSYNC_DB_PORT=5434

# ── Django ──────────────────────────────────────────────────────────────────
DJANGO_SECRET_KEY=__GENERATE__
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_LOG_LEVEL=INFO
# json (containers) | console (host development)
DJANGO_LOG_FORMAT=json
# Reverse proxies in front of Django that append to X-Forwarded-For (nginx = 1).
NUM_PROXIES=1
# Persistent DB connections per worker (seconds).
DB_CONN_MAX_AGE=60
# Cap for gzip-decompressed request bodies (bytes). Batches are ≤ 25 submissions.
FIELDSYNC_MAX_DECOMPRESSED_BYTES=524288

# ── PostgreSQL ──────────────────────────────────────────────────────────────
POSTGRES_DB=fieldsync
POSTGRES_USER=fieldsync
POSTGRES_PASSWORD=__GENERATE__
# Optional explicit URL. If unset, the API composes it from POSTGRES_* (host-run: 127.0.0.1:$FIELDSYNC_DB_PORT).
# DATABASE_URL=postgres://fieldsync:password@127.0.0.1:5434/fieldsync

# ── API server (gunicorn) ───────────────────────────────────────────────────
GUNICORN_WORKERS=2
GUNICORN_THREADS=4

# ── Auth (consumed from Phase 3) ────────────────────────────────────────────
# HMAC key for JWT signing (HS256), independent of DJANGO_SECRET_KEY.
JWT_SIGNING_KEY=__GENERATE__
JWT_ACCESS_TTL_SECONDS=600
JWT_REFRESH_TTL_DAYS=14
JWT_REFRESH_ABSOLUTE_DAYS=30
# Device key-escrow KEKs as "<id>:<base64 32 bytes>" pairs, comma-separated (rotation, ADD §11.4.3).
ESCROW_KEKS=1:__GENERATE_B64_32__
ESCROW_ACTIVE_KEY_ID=1

# ── Observability ───────────────────────────────────────────────────────────
# Bearer token required by /api/v1/metrics (mandatory in prod).
METRICS_TOKEN=__GENERATE__

# ── Demo / simulator ────────────────────────────────────────────────────────
# Enables the offline-sync simulator's server-side fault injection and demo routes.
# Production settings refuse to start when this is on.
FIELDSYNC_DEMO_MODE=1
