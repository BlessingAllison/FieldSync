{
  "code": "iccm-child-u5",
  "version": 1,
  "subject": "patient",
  "title": {
    "en": "Sick child visit (2–59 months)"
  },
  "description": {
    "en": "Illustrative integrated community case management form. Not an official Ministry of Health form."
  },
  "retain_after_sync_days": 0,
  "steps": [
    {
      "id": "child",
      "title": {
        "en": "Child"
      },
      "fields": [
        {
          "id": "patient_ref",
          "type": "text",
          "required": true,
          "pii": true,
          "label": {
            "en": "Household / child ID"
          },
          "help": {
            "en": "Format HH-0000-00 from the household register."
          },
          "rules": {
            "pattern": "^HH-[0-9]{4}-[0-9]{2}$",
            "maxLength": 16
          }
        },
        {
          "id": "age_months",
          "type": "integer",
          "required": true,
          "widget": "stepper",
          "unit": {
            "en": "months"
          },
          "label": {
            "en": "Age"
          },
          "rules": {
            "min": 2,
            "max": 59
          }
        },
        {
          "id": "sex",
          "type": "select",
          "required": true,
          "widget": "cards",
          "label": {
            "en": "Sex"
          },
          "options": [
            {
              "value": "f",
              "label": {
                "en": "Girl"
              }
            },
            {
              "value": "m",
              "label": {
                "en": "Boy"
              }
            }
          ]
        },
        {
          "id": "visit_date",
          "type": "date",
          "required": true,
          "label": {
            "en": "Visit date"
          },
          "rules": {
            "pastOnly": true
          }
        }
      ]
    },
    {
      "id": "assessment",
      "title": {
        "en": "Danger signs & assessment"
      },
      "fields": [
        {
          "id": "danger_signs",
          "type": "multiselect",
          "widget": "cards",
          "label": {
            "en": "Danger signs"
          },
          "options": [
            {
              "value": "unable_to_drink",
              "label": {
                "en": "Not able to drink or feed"
              }
            },
            {
              "value": "vomits_everything",
              "label": {
                "en": "Vomits everything"
              }
            },
            {
              "value": "convulsions",
              "label": {
                "en": "Convulsions"
              }
            },
            {
              "value": "lethargic",
              "label": {
                "en": "Very sleepy or unconscious"
              }
            },
            {
              "value": "chest_indrawing",
              "label": {
                "en": "Chest indrawing"
              }
            }
          ]
        },
        {
          "id": "fever",
          "type": "boolean",
          "required": true,
          "widget": "toggle",
          "label": {
            "en": "Fever (now or last 3 days)"
          }
        },
        {
          "id": "rdt_result",
          "type": "select",
          "required": true,
          "widget": "cards",
          "label": {
            "en": "Malaria RDT result"
          },
          "showIf": {
            "field": "fever",
            "equals": true
          },
          "options": [
            {
              "value": "positive",
              "label": {
                "en": "Positive"
              }
            },
            {
              "value": "negative",
              "label": {
                "en": "Negative"
              }
            },
            {
              "value": "not_done",
              "label": {
                "en": "Not done"
              }
            }
          ]
        },
        {
          "id": "muac_mm",
          "type": "integer",
          "widget": "muac",
          "unit": "mm",
          "label": {
            "en": "MUAC"
          },
          "help": {
            "en": "Red < 115 mm · Yellow 115–124 mm · Green ≥ 125 mm"
          },
          "rules": {
            "min": 80,
            "max": 200
          }
        }
      ]
    },
    {
      "id": "action",
      "title": {
        "en": "Treatment & referral"
      },
      "fields": [
        {
          "id": "referred",
          "type": "boolean",
          "widget": "toggle",
          "label": {
            "en": "Referred to health facility"
          }
        },
        {
          "id": "followup_on",
          "type": "date",
          "label": {
            "en": "Follow-up visit"
          },
          "rules": {
            "futureOnly": true
          }
        },
        {
          "id": "caregiver_phone",
          "type": "phone",
          "pii": true,
          "label": {
            "en": "Caregiver phone (optional)"
          }
        },
        {
          "id": "notes",
          "type": "text",
          "widget": "textarea",
          "label": {
            "en": "Notes"
          },
          "rules": {
            "maxLength": 500
          }
        }
      ]
    }
  ],
  "crossRules": [
    {
      "id": "refer_if_danger",
      "when": {
        "field": "danger_signs",
        "notEmpty": true
      },
      "require": "referred",
      "message": {
        "en": "A danger sign is present — record the referral."
      }
    }
  ]
}
