{
  "$comment": "Conformance fixtures for the form validation DSL. The TypeScript (frontend/src/core/validation) and Python (backend) engines must both produce exactly these results. Semantics are specified in contracts/README.md.",
  "version": 1,
  "now": "2026-11-19T12:00:00Z",
  "templates": {
    "basic": {
      "code": "conformance-basic",
      "version": 1,
      "subject": "patient",
      "title": {
        "en": "Conformance template"
      },
      "steps": [
        {
          "id": "main",
          "title": {
            "en": "Main"
          },
          "fields": [
            {
              "id": "name",
              "type": "text",
              "required": true,
              "label": {
                "en": "Name"
              },
              "rules": {
                "maxLength": 10
              }
            },
            {
              "id": "code",
              "type": "text",
              "label": {
                "en": "Code"
              },
              "rules": {
                "minLength": 5,
                "pattern": "^[A-Z]{2}[0-9]{3}$"
              }
            },
            {
              "id": "age",
              "type": "integer",
              "required": true,
              "label": {
                "en": "Age"
              },
              "rules": {
                "min": 2,
                "max": 59
              }
            },
            {
              "id": "weight",
              "type": "decimal",
              "label": {
                "en": "Weight"
              },
              "rules": {
                "min": 0.5,
                "max": 50
              }
            },
            {
              "id": "sex",
              "type": "select",
              "label": {
                "en": "Sex"
              },
              "options": [
                {
                  "value": "f"
                },
                {
                  "value": "m"
                }
              ]
            },
            {
              "id": "fever",
              "type": "boolean",
              "required": true,
              "label": {
                "en": "Fever"
              }
            },
            {
              "id": "rdt",
              "type": "select",
              "required": true,
              "label": {
                "en": "RDT"
              },
              "showIf": {
                "field": "fever",
                "equals": true
              },
              "options": [
                {
                  "value": "positive"
                },
                {
                  "value": "negative"
                }
              ]
            },
            {
              "id": "signs",
              "type": "multiselect",
              "label": {
                "en": "Signs"
              },
              "options": [
                {
                  "value": "a"
                },
                {
                  "value": "b"
                },
                {
                  "value": "c"
                }
              ],
              "rules": {
                "maxSelected": 2
              }
            },
            {
              "id": "referred",
              "type": "boolean",
              "label": {
                "en": "Referred"
              }
            },
            {
              "id": "visit",
              "type": "date",
              "label": {
                "en": "Visit"
              },
              "rules": {
                "pastOnly": true
              }
            },
            {
              "id": "followup",
              "type": "date",
              "label": {
                "en": "Follow-up"
              },
              "rules": {
                "futureOnly": true
              }
            },
            {
              "id": "phone",
              "type": "phone",
              "label": {
                "en": "Phone"
              }
            },
            {
              "id": "district",
              "type": "select",
              "label": {
                "en": "District"
              },
              "showIf": {
                "field": "sex",
                "in": [
                  "f",
                  "m"
                ]
              },
              "options": [
                {
                  "value": "d1"
                },
                {
                  "value": "d2"
                }
              ]
            }
          ]
        }
      ],
      "crossRules": [
        {
          "id": "refer_if_signs",
          "when": {
            "field": "signs",
            "notEmpty": true
          },
          "require": "referred",
          "message": {
            "en": "Signs present — record referral."
          }
        }
      ]
    }
  },
  "cases": [
