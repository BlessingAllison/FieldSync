{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    { "source": "/api/:path*", "destination": "https://fieldsync-production-232d90fb.up.railway.app/api/:path*" },
    { "source": "/((?!api/|assets/|sw\\.js|workbox-.*|manifest\\.webmanifest|.*\\.(?:png|svg|ico)).*)", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/(sw\\.js|manifest\\.webmanifest)",
      "headers": [{ "key": "Cache-Control", "value": "no-cache" }]
    },
    {
      "source": "/assets/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    },
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Referrer-Policy", "value": "no-referrer" }
      ]
    }
  ]
}
