{
  "name": "fieldsync-pwa",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "FieldSync — offline-first health data collection PWA (demonstration project).",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck && vite build",
    "build:bundle": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc -p tsconfig.app.json --noEmit && tsc -p tsconfig.sw.json --noEmit && tsc -p tsconfig.node.json --noEmit",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write \"src/**/*.{ts,tsx,css,json}\" \"e2e/**/*.ts\" \"scripts/**/*.mjs\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "playwright test",
    "size": "size-limit",
    "gen:api": "openapi-typescript ../contracts/openapi.json -o src/core/api/schema.gen.d.ts && prettier --write src/core/api/schema.gen.d.ts",
    "gen:contracts": "node scripts/gen-contracts.mjs && prettier --write src/core/contracts/error-codes.gen.ts",
    "gen:i18n": "node scripts/gen-pseudo-locale.mjs",
    "gen:icons": "pwa-assets-generator",
    "gen": "npm run gen:contracts && npm run gen:api && npm run gen:i18n",
    "contracts:check": "npm run gen && git diff --exit-code -- src/core/contracts src/core/api/schema.gen.d.ts src/i18n/locales"
  },
  "dependencies": {
    "@radix-ui/react-slot": "1.1.1",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "framer-motion": "11.15.0",
    "idb": "8.0.1",
    "lucide-react": "0.468.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-router-dom": "6.28.0",
    "tailwind-merge": "2.6.0",
    "workbox-core": "7.3.0",
    "workbox-precaching": "7.3.0",
    "workbox-routing": "7.3.0",
    "workbox-window": "7.3.0",
    "zustand": "5.0.2"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.10.1",
    "@eslint/js": "9.17.0",
    "@playwright/test": "1.49.1",
    "@size-limit/file": "11.1.6",
    "@testing-library/dom": "10.4.0",
    "@testing-library/jest-dom": "6.6.3",
    "@testing-library/react": "16.1.0",
    "@testing-library/user-event": "14.5.2",
    "@types/node": "22.10.2",
    "@types/react": "18.3.18",
    "@types/react-dom": "18.3.5",
    "@vite-pwa/assets-generator": "0.2.6",
    "@vitejs/plugin-react": "4.3.4",
    "autoprefixer": "10.4.20",
    "eslint": "9.17.0",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react-hooks": "5.1.0",
    "eslint-plugin-react-refresh": "0.4.16",
    "fake-indexeddb": "6.0.0",
    "globals": "15.14.0",
    "jsdom": "25.0.1",
    "openapi-typescript": "7.4.4",
    "playwright-core": "1.49.1",
    "postcss": "8.4.49",
    "prettier": "3.4.2",
    "prettier-plugin-tailwindcss": "0.6.9",
    "size-limit": "11.1.6",
    "tailwindcss": "3.4.17",
    "tailwindcss-animate": "1.0.7",
    "typescript": "5.7.2",
    "typescript-eslint": "8.18.1",
    "vite": "5.4.11",
    "vite-plugin-pwa": "0.21.1",
    "vitest": "2.1.8",
    "workbox-build": "7.3.0"
  }
}
